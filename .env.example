APP_ENV=local

FRONTEND_PORT=3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3002,https://edu-alto.vercel.app,https://edualto.vercel.app

POSTGRES_DB=edualto
POSTGRES_USER=edualto
# Change this before creating a new local PostgreSQL volume.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PORT=6379

JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_ISSUER=edualto
REFRESH_TOKEN_TTL_DAYS=14
# Local HTTP uses Lax and Secure=false. Cross-site production cookies need None and Secure=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=Lax
# Generate a local value with: openssl rand -base64 48
JWT_SECRET=

OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Keep blank by default. Use a fixed code only for local manual testing.
OTP_FIXED_CODE=

AUTH_RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_CLIENTS=10000

# Set true only after filling Gmail SMTP values. Use a Gmail app password, never your account password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-gmail-address@gmail.com
MAIL_SENDER_NAME=EduAlto

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=edualto-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL_PREFIX=

# Optional VNPay sandbox configuration. Leave credentials blank to disable gateway checkout.
EDUALTO_PAYMENT_VNPAY_TMN_CODE=
EDUALTO_PAYMENT_VNPAY_HASH_SECRET=
EDUALTO_PAYMENT_VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
EDUALTO_PAYMENT_VNPAY_RETURN_URL=http://localhost:3002/checkout/result
