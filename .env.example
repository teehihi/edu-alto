APP_ENV=local

FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

POSTGRES_DB=edualto
POSTGRES_USER=edualto
# Change this before creating a new local PostgreSQL volume.
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432

REDIS_PORT=6379

JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_ISSUER=edualto
REFRESH_TOKEN_TTL_DAYS=14
# Generate a local value with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Keep blank by default. Use a fixed code only for local manual testing.
OTP_FIXED_CODE=

MAIL_FROM=no-reply@edualto.local
