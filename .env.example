# Application
APP_ENV=local

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=
# PostgreSQL
POSTGRES_DB=edualto
POSTGRES_USER=edualto
POSTGRES_PASSWORD=
SPRING_DATASOURCE_PASSWORD=
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Authentication
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_ISSUER=edualto
REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=None
JWT_SECRET=

# OTP
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_FIXED_CODE=

# Authentication rate limiting
AUTH_RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_CLIENTS=10000

# Mail
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SENDER_NAME=EduAlto

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL_PREFIX=

