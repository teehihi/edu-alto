flowchart TB
  subgraph Client["Client application boundary"]
    Browser["Browser"]
    NextApp["Next.js Web App\nReact + TypeScript + Tailwind CSS"]
  end

  subgraph APIBoundary["Backend API boundary"]
    Rest["REST API\n/api/v1"]
