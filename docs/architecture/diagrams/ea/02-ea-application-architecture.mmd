    Enrollment["enrollment/learning"]
    Assessment["quiz/assignment"]
    Community["discussion/messaging"]
    Engagement["notification/schedule/review/certificate"]
    Admin["admin"]
    Analytics["analytics"]
    AI["ai\nfuture extension"]
  end

  subgraph Support["Application support services boundary"]
    PostgreSQL[("PostgreSQL")]
    Redis[("Redis")]
    Email["Email Provider"]
    FutureAI["Future AI Provider\noptional"]
  end

  Browser --> NextApp
  NextApp --> Rest
